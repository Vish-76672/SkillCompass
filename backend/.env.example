# Copy this file to .env and fill in your key.
# Get a free key from Google AI Studio: https://ai.google.dev/gemini-api/docs/api-key
#
# If GEMINI_API_KEY is left empty, the app still works -- it just falls back
# to rule-based analysis for the six roles that have a static skill table
# (see roles_data.py), and the other nine roles will return an error asking
# you to add a key.

GEMINI_API_KEY=

# Optional: override the model (defaults to gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
